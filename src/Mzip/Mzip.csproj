<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>mzip.ico</ApplicationIcon>
    <AssemblyName>Mzip</AssemblyName>
    <RootNamespace>Mzip</RootNamespace>
    <Version>1.2.1</Version>
    <FileVersion>1.2.1.0</FileVersion>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <Company>MSoft</Company>
    <Product>Mzip</Product>
    <Description>Compresor y extractor de archivos</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>es;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.50.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- El proyecto de pruebas comprueba también los tipos internos (ShellArguments). -->
    <InternalsVisibleTo Include="Mzip.CoreTests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="mzip.ico" />
    <Resource Include="Theme.xaml" />
    <Resource Include="Assets\mzip-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- 7-Zip standalone para crear 7z con compresión sólida LZMA2 (dominio público). -->
    <EmbeddedResource Include="Tools\7zr.exe" LogicalName="Mzip.Tools.7zr.exe" />
  </ItemGroup>

</Project>
