<Window x:Class="Mzip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mzip"
        Height="800" Width="1180" MinHeight="660" MinWidth="1000"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        Icon="mzip.ico"
        AllowDrop="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        DragOver="Window_DragOver"
        Drop="Window_Drop"
        KeyDown="Window_KeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0" Margin="26,22,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="54" Height="54" CornerRadius="15" Background="{StaticResource AccentGradient}">
                <Viewbox Width="28" Height="28">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3 8 H21 V20 H3 Z M3 8 L5 4 H19 L21 8 M9 12 H15"
                              Stroke="#1B1207" StrokeThickness="1.9" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Mzip" FontSize="26" FontWeight="Bold" />
                <TextBlock Text="Compresor y extractor de archivos" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border x:Name="AdminBadge" Background="#152A22" BorderBrush="#23503A" BorderThickness="1"
                        CornerRadius="20" Padding="12,6" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AdminDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="AdminText" Text="Administrador" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="7,0,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="VersionLabel" Text="v1.1.0 · MSoft" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Right" Margin="0,6,2,0" />
            </StackPanel>
        </Grid>

        <!-- Selector de modo -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1" CornerRadius="12" Padding="4" HorizontalAlignment="Left" Margin="26,20,26,16">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="CompressTab" Content="Comprimir" Style="{StaticResource Segment}"
                             GroupName="mode" IsChecked="True" Checked="Mode_Checked" />
                <RadioButton x:Name="ExtractTab" Content="Extraer" Style="{StaticResource Segment}"
                             GroupName="mode" Checked="Mode_Checked" />
            </StackPanel>
        </Border>

        <!-- Comprimir -->
        <Grid x:Name="CompressPanel" Grid.Row="2" Margin="26,0,26,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Archivos" Style="{StaticResource H1}" />
                            <Border Background="{StaticResource Surface2Brush}" CornerRadius="20" Padding="7,2"
                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="FileCountText" Text="0 elementos" FontSize="10.5"
                                           Foreground="{StaticResource MutedBrush}" />
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="CompressToolsPanel" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="AddFilesButton" Content="Añadir archivos" Style="{StaticResource SmallPrimary}" Click="AddFiles_Click" />
                            <Button x:Name="AddFolderButton" Content="Carpeta" Style="{StaticResource SmallSecondary}" Click="AddFolder_Click" Margin="8,0,0,0" />
                            <Button x:Name="ClearButton" Content="Limpiar" Style="{StaticResource SmallGhost}" Click="Clear_Click" Margin="2,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="CompressDrop" Grid.Row="1" Height="116" Margin="0,14,0,0" Background="Transparent"
                          AllowDrop="True" Cursor="Hand"
                          DragOver="CompressDrop_DragOver" Drop="CompressDrop_Drop" MouseLeftButtonUp="CompressDrop_Click">
                        <Rectangle Stroke="{StaticResource BorderBrush}" StrokeThickness="1.3" StrokeDashArray="4 4"
                                   RadiusX="12" RadiusY="12" Fill="#0D131B" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="42" Height="42" CornerRadius="12" Background="#18222D" Margin="0,0,14,0">
                                <Path Data="M12 4 V16 M7 11 L12 16 L17 11 M5 20 H19" Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Stretch="Uniform" Width="20" Height="20" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Arrastra archivos o carpetas aquí" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="o pulsa para seleccionar archivos" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="2" Margin="2,8,0,0" FontSize="10.5" TextWrapping="Wrap"
                               Foreground="{StaticResource FaintBrush}"
                               Text="También acepta carpetas completas; se conservan sus nombres y las carpetas vacías." />

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <ListBox x:Name="FilesList" ItemContainerStyle="{StaticResource RowItem}"
                                 SelectionMode="Extended" KeyDown="FilesList_KeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36" Height="36" CornerRadius="9" Background="#17222E" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentSoftBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="11,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Location}" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11.5"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Grid.Column="3" Content="✕" Style="{StaticResource DangerIconButton}"
                                                Click="RemoveFile_Click" Tag="{Binding}" ToolTip="Quitar de la lista"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="FilesEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="La lista está vacía" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Añade archivos o carpetas para empezar" FontSize="11"
                                       Foreground="{StaticResource FaintBrush}" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="4" Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,9" Margin="0,2,0,0">
                        <Grid>
                            <TextBlock Text="Tamaño total" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="FilesTotalText" Text="0 B" FontSize="12" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CompressOptionsPanel">
                        <TextBlock Text="Opciones" Style="{StaticResource H1}" />

                        <TextBlock Text="Formato de salida" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,16,0,7" />
                        <WrapPanel>
                            <RadioButton x:Name="ZipFormatTab" Content="ZIP" Style="{StaticResource FormatPill}"
                                         GroupName="format" IsChecked="True" Checked="Options_Checked" Margin="0,0,8,8" />
                            <RadioButton x:Name="SevenZipFormatTab" Content="7Z" Style="{StaticResource FormatPill}"
                                         GroupName="format" Checked="Options_Checked" Margin="0,0,8,8" />
                            <RadioButton x:Name="TarFormatTab" Content="TAR" Style="{StaticResource FormatPill}"
                                         GroupName="format" Checked="Options_Checked" Margin="0,0,8,8" />
                            <RadioButton x:Name="TarGzFormatTab" Content="TAR.GZ" Style="{StaticResource FormatPill}"
                                         GroupName="format" Checked="Options_Checked" Margin="0,0,8,8" />
                            <RadioButton x:Name="TarBz2FormatTab" Content="TAR.BZ2" Style="{StaticResource FormatPill}"
                                         GroupName="format" Checked="Options_Checked" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock Text="7Z comprime más (LZMA2). TAR.GZ y TAR.BZ2 son los estándar de Linux y macOS."
                                   FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}" Margin="2,0,0,0" />

                        <TextBlock Text="Nombre del archivo" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,16,0,7" />
                        <TextBox x:Name="ArchiveNameBox" Style="{StaticResource Input}" TextChanged="Options_TextChanged" />

                        <TextBlock Text="Carpeta de destino" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,14,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DestinationBox" Style="{StaticResource Input}" TextChanged="Options_TextChanged" />
                            <Button x:Name="BrowseDestButton" Grid.Column="1" Content="Examinar"
                                    Style="{StaticResource SmallSecondary}" Click="BrowseDest_Click" Margin="8,0,0,0" />
                        </Grid>

                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,16,0,0">
                            <Grid>
                                <TextBlock Text="Se guardará como" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="OutputHintText" Text="mzip.zip" FontSize="11.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            </Grid>
                        </Border>

                        <Button x:Name="CompressButton" Content="Comprimir" Style="{StaticResource PrimaryButton}"
                                Height="44" Margin="0,16,0,0" FontSize="13.5" Click="Compress_Click" />

                        <TextBlock Margin="2,12,0,0" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}"
                                   Text="Se conservan las carpetas, las carpetas vacías y las fechas de modificación." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Extraer -->
        <Grid x:Name="ExtractPanel" Grid.Row="2" Margin="26,0,26,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <TextBlock Text="Archivo comprimido" Style="{StaticResource H1}" VerticalAlignment="Center" />
                        <Button x:Name="BrowseArchiveButton" Content="Elegir archivo" Style="{StaticResource SmallPrimary}"
                                HorizontalAlignment="Right" Click="BrowseArchive_Click" />
                    </Grid>

                    <Grid x:Name="ExtractDrop" Grid.Row="1" Height="96" Margin="0,14,0,0" Background="Transparent"
                          AllowDrop="True" Cursor="Hand"
                          DragOver="ExtractDrop_DragOver" Drop="ExtractDrop_Drop" MouseLeftButtonUp="ExtractDrop_Click">
                        <Rectangle Stroke="{StaticResource BorderBrush}" StrokeThickness="1.3" StrokeDashArray="4 4"
                                   RadiusX="12" RadiusY="12" Fill="#0D131B" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="40" Height="40" CornerRadius="11" Background="#18222D" Margin="0,0,13,0">
                                <Path Data="M4 7 H20 V19 H4 Z M4 7 L6 4 H18 L20 7 M9 12 H15" Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="1.8" StrokeLineJoin="Round" Stretch="Uniform" Width="20" Height="20" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Arrastra un comprimido aquí" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="ZIP, TAR, 7Z, RAR, GZ, BZ2 o XZ" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ArchiveInfo" Grid.Row="2" Margin="0,12,0,0" Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="11"
                            Padding="13" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="10" Background="#24180D">
                                <TextBlock x:Name="ArchiveBadgeText" Text="ZIP" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{StaticResource AccentSoftBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ArchiveNameText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="ArchiveMetaText" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="Cambiar" Style="{StaticResource SmallGhost}"
                                    Click="BrowseArchive_Click" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <ListBox x:Name="EntriesList" ItemContainerStyle="{StaticResource RowItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="34" Height="34" CornerRadius="8" Background="#17222E" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Badge}" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentSoftBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12.5"
                                                   Margin="10,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ExtractEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="Aún no hay ningún archivo abierto" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Elige un comprimido para ver su contenido" FontSize="11"
                                       Foreground="{StaticResource FaintBrush}" Margin="0,3,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ExtractOptionsPanel">
                        <TextBlock Text="Opciones" Style="{StaticResource H1}" />

                        <TextBlock Text="Carpeta de destino" Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,16,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ExtractDestBox" Style="{StaticResource Input}" />
                            <Button x:Name="BrowseExtractDestButton" Grid.Column="1" Content="Examinar"
                                    Style="{StaticResource SmallSecondary}" Click="BrowseExtractDest_Click" Margin="8,0,0,0" />
                        </Grid>

                        <TextBlock Text="Contraseña (solo si el archivo está protegido)" Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5" Margin="0,14,0,7" TextWrapping="Wrap" />
                        <PasswordBox x:Name="ExtractPassword" Style="{StaticResource PasswordInput}" />

                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                            <CheckBox x:Name="OverwriteCheck" Content="Sobrescribir archivos existentes"
                                      Style="{StaticResource ModernCheck}" IsChecked="True" />
                        </Border>

                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                            <StackPanel>
                                <CheckBox x:Name="ShellIntegrationCheck" Content="Añadir al menú contextual de Windows"
                                          Style="{StaticResource ModernCheck}"
                                          Checked="ShellIntegration_Toggled" Unchecked="ShellIntegration_Toggled" />
                                <TextBlock Text="«Extraer aquí», «Extraer en una subcarpeta» y «Comprimir con Mzip» al pulsar con el botón derecho."
                                           FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Surface2Brush}" CornerRadius="10" Padding="12,10" Margin="0,10,0,0">
                            <Grid>
                                <TextBlock Text="Contenido" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ExtractSummaryText" Text="Sin archivo" FontSize="11.5" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            </Grid>
                        </Border>

                        <Button x:Name="ExtractButton" Content="Extraer" Style="{StaticResource PrimaryButton}"
                                Height="44" Margin="0,16,0,0" FontSize="13.5" Click="Extract_Click" IsEnabled="False" />

                        <TextBlock Margin="2,12,0,0" FontSize="10.5" TextWrapping="Wrap" Foreground="{StaticResource FaintBrush}"
                                   Text="Los archivos se validan para que ninguna entrada pueda escribirse fuera de la carpeta de destino." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Estado -->
        <Border Grid.Row="3" Margin="26,16,26,20" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Listo" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="Progress" Style="{StaticResource SlimProgress}" Maximum="100" Value="0" Margin="0,9,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource SmallGhost}"
                            Click="Cancel_Click" Visibility="Collapsed" />
                    <Button x:Name="OpenFolderButton" Content="Abrir carpeta" Style="{StaticResource SmallSecondary}"
                            Click="OpenFolder_Click" Visibility="Collapsed" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
