<Window x:Class="MzipSetupExe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalador de Mzip"
        Height="740" Width="720" MinHeight="720" MinWidth="660"
        Background="{StaticResource WindowBg}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource AppFont}"
        WindowStartupLocation="CenterScreen"
        Icon="mzip.ico"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

    <Grid Margin="28,22,28,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="54" Height="54" CornerRadius="15" Background="{StaticResource AccentGradient}">
                <Viewbox Width="28" Height="28">
                    <Canvas Width="24" Height="24">
                        <Path Data="M3 8 H21 V20 H3 Z M3 8 L5 4 H19 L21 8 M9 12 H15"
                              Stroke="#1B1207" StrokeThickness="1.9" StrokeLineJoin="Round"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Instalar Mzip" FontSize="24" FontWeight="Bold" />
                <TextBlock x:Name="SubtitleText" Text="Instalador · versión 1.0.0" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border x:Name="AdminBadge" Background="#152A22" BorderBrush="#23503A" BorderThickness="1"
                        CornerRadius="20" Padding="12,6" HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="AdminDot" Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="AdminText" Text="Administrador" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}" Margin="7,0,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="VersionText" Text="v1.0.0 · MSoft" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Right" Margin="0,6,2,0" />
            </StackPanel>
        </Grid>

        <!-- Destino -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="Ubicación de instalación" Style="{StaticResource H1}" />
                <TextBlock Text="Mzip quedará disponible para todos los usuarios del equipo."
                           Style="{StaticResource Caption}" Margin="0,4,0,0" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DestBox" Style="{StaticResource Input}" />
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Examinar"
                            Style="{StaticResource SmallSecondary}" Margin="8,0,0,0" Click="Browse_Click" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Opciones -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Opciones" Style="{StaticResource H1}" />
                <CheckBox x:Name="DesktopCheck" Content="Crear acceso directo en el escritorio"
                          Style="{StaticResource ModernCheck}" IsChecked="True" Margin="0,14,0,0" />
                <CheckBox x:Name="StartMenuCheck" Content="Añadir Mzip al menú Inicio"
                          Style="{StaticResource ModernCheck}" IsChecked="True" Margin="0,12,0,0" />
                <CheckBox x:Name="ShellCheck" Content="Añadir «Extraer aquí» al menú contextual"
                          Style="{StaticResource ModernCheck}" IsChecked="True" Margin="0,12,0,0" />
                <CheckBox x:Name="LaunchCheck" Content="Abrir Mzip al finalizar la instalación"
                          Style="{StaticResource ModernCheck}" IsChecked="True" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <!-- Aviso -->
        <Border Grid.Row="3" Margin="0,12,0,0" Background="#141B24" BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1" CornerRadius="11" Padding="14,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="HintText" Grid.Column="1" Margin="10,0,0,0" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}"
                           Text="El instalador solicitará permisos de administrador para escribir en Program Files y registrar la desinstalación en Windows." />
            </Grid>
        </Border>

        <!-- Progreso -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14">
            <StackPanel>
                <TextBlock x:Name="StatusText" Text="Listo para instalar." FontSize="12"
                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" Style="{StaticResource SlimProgress}" Maximum="100" Value="0" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Acciones -->
        <Grid Grid.Row="5" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Content="Cerrar" Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left" Width="110" Height="44" Click="Close_Click" />
            <Button x:Name="InstallButton" Content="Instalar" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" Width="180" Height="44" FontSize="13.5" Click="Install_Click" />
        </Grid>

        <!-- Pie -->
        <TextBlock Grid.Row="6" Text="MSoft · msoft.com.es" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,14,0,0" />
    </Grid>
</Window>
